NODE_ENV=development
PORT=3000
INSTANCE_ID=gateway-local

DATABASE_URL=postgres://gateway:gateway@localhost:5432/gateway
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=10000
PG_CONNECTION_TIMEOUT_MS=3000
PG_STATEMENT_TIMEOUT_MS=2000

REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=1000
REDIS_COMMAND_TIMEOUT_MS=200
REDIS_MAX_RETRIES=1

ADMIN_API_KEY=dev-admin-key-change-me
API_KEY_PEPPER=dev-pepper-change-me

POLICY_CACHE_TTL_MS=5000
POLICY_CACHE_MAX=10000
API_KEY_CACHE_TTL_MS=5000
API_KEY_CACHE_MAX=5000

DEFAULT_FAIL_MODE=fail_closed
DEFAULT_UPSTREAM_TIMEOUT_MS=3000
SHUTDOWN_DRAIN_MS=10000

LOG_LEVEL=info

# Interactive lab (/demo/). Sandboxes are short-lived tenants created by visitors.
DEMO_SANDBOX_ENABLED=false
DEMO_SANDBOX_TTL_MS=1800000
DEMO_SANDBOX_MAX=50
DEMO_SANDBOX_MAX_PER_IP=3
DEMO_SWEEP_INTERVAL_MS=60000
DEMO_LAB_UPSTREAM_URL=http://localhost:4000
# Every gateway instance, so the lab can show per-instance breaker and cache state.
DEMO_PEER_URLS=
DEMO_PUBLIC_ACME_KEY=
DEMO_PUBLIC_GLOBEX_KEY=
